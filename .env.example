# =======================================================
# SAVERA PARADISE - ENVIRONMENT CONFIGURATION TEMPLATE
# =======================================================

# --- Cloudflare R2 Object Storage (Server-side / Serverless Functions only) ---
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_HOST=your-account-id.r2.cloudflarestorage.com
R2_REGION=auto

# --- Supabase Unified Database & Realtime ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# --- Cashfree Payments Gateway & Payouts ---
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
RESTAURANT_UPI_VPA=saveraparadise@okhdfcbank

# --- Ola Maps / Geocoding (Optional) ---
OLA_MAPS_API_KEY=your_ola_maps_api_key
STORE_LAT=12.720611
STORE_LNG=77.286833

# --- Staff Authentication & Session Security (Server-side only) ---
ADMIN_PIN=8899
OWNER_PIN=9900
SESSION_SECRET=your_custom_random_secure_session_secret_32chars_minimum
