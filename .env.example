# =======================================================
# RESTAURANT 2 - ENVIRONMENT CONFIGURATION TEMPLATE
# =======================================================

# --- Cloudflare R2 Object Storage (Server-side / Serverless Functions only) ---
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_HOST=your-account-id.r2.cloudflarestorage.com
R2_REGION=auto

# --- Supabase Unified Database & Realtime (Client-safe anon key) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# --- Ola Maps / Geocoding (Optional) ---
OLA_MAPS_API_KEY=your_ola_maps_api_key
STORE_LAT=12.720611
STORE_LNG=77.286833

# --- Admin Staff Authentication & Session Security (Server-side only) ---
ADMIN_PIN=1234
SESSION_SECRET=your_custom_random_secure_session_secret_32chars
